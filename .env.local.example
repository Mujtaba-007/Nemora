# Nemora Frontend Environment Configuration Example
# Copy this file to .env.local and populate with your project credentials.

# Public Supabase credentials (safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: Do NOT place SUPABASE_SERVICE_ROLE_KEY, GROQ_API_KEY, or GUEST_CLAIM_SECRET here!
# Edge Function secrets must only be configured via `supabase secrets set`.
